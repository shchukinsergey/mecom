# Configure these as hosting environment variables; the server does not load .env automatically.
MECOM_PUBLIC_ORIGIN=https://your-mecom.example
MECOM_TELEGRAM_BOT_TOKEN=
# Username without @
MECOM_TELEGRAM_BOT_USERNAME=
# 16–256 characters: A–Z, a–z, 0–9, underscore, hyphen
MECOM_TELEGRAM_WEBHOOK_SECRET=
